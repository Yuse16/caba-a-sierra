# URL del proyecto Supabase. Copia este archivo a .env.local para desarrollo.
NEXT_PUBLIC_SUPABASE_URL=

# Llave anon del proyecto. Puede exponerse al navegador; RLS sigue siendo obligatorio.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this value with NEXT_PUBLIC_ and never expose it
# to browser code. It is reserved for audited maintenance jobs such as media
# cleanup, not ordinary panel reads or writes.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used for allowlisted authentication callbacks.
NEXT_PUBLIC_SITE_URL=
