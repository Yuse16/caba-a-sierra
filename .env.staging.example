# URL HTTPS del alias estable de la rama Preview de Vercel, sin diagonal final.
STAGING_PREVIEW_URL=

# Credenciales de cuentas exclusivas del proyecto Supabase de staging.
# Nunca reutilices contraseñas personales ni de producción.
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=
STAGING_EDITOR_EMAIL=
STAGING_EDITOR_PASSWORD=

# Valores públicos del proyecto Supabase de staging.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sólo para el runtime server-side que carga y limpia galerías de cabañas.
# Nunca usar prefijo NEXT_PUBLIC_ ni exponerla al navegador.
SUPABASE_SERVICE_ROLE_KEY=
